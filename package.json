{
  "name": "giborei-hamoked",
  "private": true,
  "version": "1.0.0",
  "description": "משחק RTL לילדים על בחירות בטוחות ועזרה הדדית",
  "author": "גיבורי המוקד",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "electron": "^32.2.6",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.giboreihamoked.app",
    "productName": "גיבורי המוקד",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "publish": []
  }
}
